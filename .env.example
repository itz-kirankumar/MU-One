# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
# Copy this file to frontend/.env.local and fill in real values.
# These variables are NEXT_PUBLIC_ and will be bundled in the client.
# They are NOT secret — they identify the Firebase project.

NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mu-one-508502.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mu-one-508502
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mu-one-508502.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
# Leave unset to use the project's default Firestore database. Set ONLY if you
# created a *named* (non-default) database. The literal value 'default' is wrong.
# NEXT_PUBLIC_FIREBASE_DATABASE_ID=

# ─── Cloud Functions (stored in Secret Manager, NOT in .env files) ────────────
# These are documented here for reference. Store them in Firebase Secret Manager:
#   firebase functions:secrets:set GOOGLE_OAUTH_CLIENT_ID
#   firebase functions:secrets:set GOOGLE_OAUTH_CLIENT_SECRET
#   firebase functions:secrets:set TOKEN_ENCRYPTION_KEY   (32-byte hex AES-256 key)

# GOOGLE_OAUTH_CLIENT_ID=     (from Google Cloud Console → OAuth 2.0 Client)
# GOOGLE_OAUTH_CLIENT_SECRET= (from Google Cloud Console → OAuth 2.0 Client)
# TOKEN_ENCRYPTION_KEY=       (openssl rand -hex 32)

# ─── Allowed domain ───────────────────────────────────────────────────────────
# MU_ALLOWED_DOMAIN=mastersunion.org   (default; change only for staging)
