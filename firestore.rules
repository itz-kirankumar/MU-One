rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: caller must be signed in with a @mastersunion.org email
    function isMuUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@mastersunion\\.org$');
    }

    // Private beta admission. The admin account is always admitted; every
    // other account must have a server-managed allowlist document.
    function hasPlatformAccess() {
      return isMuUser()
        && (
          request.auth.token.email.lower() == 'kiran.kumar2028@mastersunion.org'
          || exists(/databases/$(database)/documents/platformAccess/$(request.auth.token.email.lower()))
        );
    }

    // Helper: caller is the owner of this uid subtree
    function isOwner(uid) {
      return hasPlatformAccess() && request.auth.uid == uid;
    }

    // Helper: valid personal task fields
    function validTask() {
      let d = request.resource.data;
      return d.title is string
        && d.title.size() >= 1
        && d.title.size() <= 120
        && d.importance in ['important', 'must_do']
        && d.completed is bool;
    }

    // ── User root document ────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid);
      // Profile updates are allowed from the client (display name, focus, etc.)
      allow write: if isOwner(uid);

      // ── Personal tasks — client CRUD ─────────────────────────────────────
      match /personalTasks/{taskId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validTask();
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }

      // ── Weekly focus — client read/write ─────────────────────────────────
      match /focus/current {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500;
      }

      // ── Dashboard snapshot — written only by Cloud Functions (Admin SDK) ──
      match /dashboard/current {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // ── Sync jobs — written only by Cloud Functions ───────────────────────
      match /syncJobs/{jobId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // ── Imported sources — de-dup ledger, Functions-owned ─────────────────
      match /importedSources/{sourceKey} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // ── Normalized calendar events — Functions-owned ──────────────────────
      match /calendarEvents/{eventId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // ── Normalized mail signals — Functions-owned ─────────────────────────
      match /mailSignals/{msgId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // ── Normalized Google Tasks — Functions-owned ─────────────────────────
      match /googleTasks/{taskId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Surveys are shared through verified-member callable functions only.
    // Direct reads would expose owner IDs or the private participation ledger.
    match /surveys/{document=**} {
      allow read, write: if false;
    }

    // Sanitized institutional timetable events are readable by verified MU users.
    // Cloud Functions are the only writer, so personal calendar data cannot be
    // inserted by clients.
    match /sharedCalendarEvents/{eventId} {
      allow read: if hasPlatformAccess();
      allow write: if false;
    }

    // Admission and waitlist records are available only through callable
    // functions, where administrator checks and field validation are enforced.
    match /platformAccess/{document=**} {
      allow read, write: if false;
    }

    // Shared announcements
    match /announcements/{id} {
      allow read: if hasPlatformAccess();
      allow write: if isMuUser() && request.auth.token.email.lower() == 'kiran.kumar2028@mastersunion.org';
    }

    match /platformWaitlist/{document=**} {
      allow read, write: if false;
    }

    // ── Founder Connect ──────────────────────────────────────────────────────

    // Profiles hold questionnaire answers, the imported LinkedIn record and the
    // statement of purpose. Another student is only ever shown the summary the
    // callable projects, never the document.
    match /founderProfiles/{document=**} {
      allow read, write: if false;
    }

    match /founderLinkedInStates/{document=**} {
      allow read, write: if false;
    }

    match /founderLinkedInConnections/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Cached pair scores name both uids; readable only through the callable,
    // which checks that the caller is one of them.
    match /founderMatches/{document=**} {
      allow read, write: if false;
    }

    // Posts carry authorUid even when the post is anonymous, so a client can
    // never read the document. The callable strips the author before returning.
    match /founderPosts/{document=**} {
      allow read, write: if false;
    }

    // DM threads are the one Founder Connect read path open to clients, so the
    // browser can listen for new messages live. There is no anonymity to
    // protect here, and the participants array bounds the read to the two
    // people in the conversation. Writes still go through the callable, which
    // owns the unread counters and the thread summary.
    match /founderThreads/{threadId} {
      allow read: if hasPlatformAccess()
        && request.auth.uid in resource.data.participants;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if hasPlatformAccess()
          && request.auth.uid in get(/databases/$(database)/documents/founderThreads/$(threadId)).data.participants;
        allow write: if false;
      }
    }

    // Deny all other paths explicitly
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
